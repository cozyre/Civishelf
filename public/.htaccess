Options -Indexes

<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteBase /Civishelf/
    
    # If the request is for a real file or directory, serve it directly
    # This lets /assets/css/style.css, /assets/js/main.js etc. be served normally
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteCond %{REQUEST_FILENAME} !-d
    
    # Otherwise route everything through index.php
    RewriteRule ^(.+)$ index.php?url=$1 [QSA,L]
</IfModule>
